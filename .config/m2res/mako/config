# m2res — уведомления в стиле райса: тёмные «пилюли» с акцентной обводкой (цвета из colors.json)
# Системный ~/.config/mako/config не тронут. Включить: m2res-notify on | вернуть: m2res-notify off
layer=overlay
anchor=top-right
output=DP-3
outer-margin=10,16,0,0
margin=8
width=430
height=180
padding=14,18,14,16
max-visible=5
on-notify=exec $HOME/.config/m2res/scripts/m2res-notify-log
default-timeout=6000
group-by=app-name
sort=-time

font=CaskaydiaMono Nerd Font Bold 11
text-color=#e8ead8
background-color=#0a0a0cdc
border-size=2
border-color=#b0d500
border-radius=20
text-alignment=left
markup=1
format=<span color="#b0d500" size="small" font_weight="heavy"><b>%a</b></span>\n<b>%s</b>\n<span color="#b4b6a6">%b</span>

icons=1
max-icon-size=44
icon-location=left
icon-border-radius=12
progress-color=over #b0d50030

[urgency=low]
border-color=#4a4a4e
default-timeout=4000
text-color=#a8a8a2
format=<span color="#6e6e6e" size="small"><b>%a</b></span>\n<b>%s</b>\n<span color="#808080">%b</span>

[urgency=critical]
border-color=#b0d500
background-color=#160a0edc
default-timeout=0
format=<span color="#b0d500" size="small"><b>󰀦  %a</b></span>\n<b>%s</b>\n<span color="#d8b4bc">%b</span>

[summary="Brightness"]
border-color=#ffd166
format=<span color="#ffd166" size="small"><b>󰃟  BRIGHTNESS</b></span>\n<b>%b</b>

[mode=do-not-disturb]
invisible=1
