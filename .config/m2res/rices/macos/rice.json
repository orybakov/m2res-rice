{
 "extends": "m2res",
 "order": 70,
 "title": "macOS",
 "icon": "",
 "desc": "клон macOS: строка меню сверху, нижний док с иконками, светлое стекло, синий акцент, системные скругления",
 "palette": {
  "accent": "#0a84ff",
  "pill_bg": "rgba(255, 255, 255, 0.0)",
  "pill_hover": "rgba(0, 0, 0, 0.07)",
  "pill_fg": "#1d1d1f",
  "pill_dim": "#6e6e73",
  "pill_ink": "#ffffff"
 },
 "widgets": {
  "frame": "glass",
  "shape": "round",
  "rk": 1.2,
  "border_w": 1,
  "bg": [
   0.97,
   0.97,
   0.98,
   0.8
  ],
  "fg": [
   0.11,
   0.11,
   0.12
  ],
  "dim": [
   0.43,
   0.43,
   0.45
  ],
  "ink": [
   0,
   0,
   0
  ],
  "on_acc": [
   1,
   1,
   1
  ],
  "font": "Noto Sans",
  "tint": true,
  "border_a": 0.5
 },
 "bar": {
  "height": 30,
  "margin": [
   0,
   0,
   0,
   0
  ],
  "island": 0,
  "position": "top",
  "spacing": 0,
  "css": "bar.css",
  "left": [
   "custom/apple",
   "hyprland/window"
  ],
  "center": [],
  "right": [
   "custom/rec",
   "custom/notif",
   "custom/control",
   "pulseaudio",
   "clock"
  ],
  "hide": [
   "memory",
   "custom/weather",
   "tray",
   "custom/profile",
   "custom/timer",
   "custom/rice",
   "hyprland/language",
   "hyprland/workspaces"
  ],
  "modules": {
   "custom/apple": {
    "format": "",
    "tooltip": false,
    "on-click": "m2res-launcher"
   },
   "hyprland/window": {
    "format": "<b>{}</b>",
    "max-length": 44,
    "separate-outputs": true
   },
   "clock": {
    "format": "{0:%a %d %b  %H:%M}",
    "tooltip": false
   }
  }
 },
 "border": "solid",
 "hypr": {
  "gaps_in": 6,
  "gaps_out": 12,
  "border_size": 2,
  "rounding": 10,
  "rounding_power": 2,
  "active_opacity": 0.97,
  "inactive_opacity": 0.92,
  "blur": {
   "enabled": true,
   "size": 10,
   "passes": 4,
   "new_optimizations": true,
   "ignore_opacity": true,
   "xray": false,
   "vibrancy": 0.25
  },
  "shadow": {
   "enabled": true,
   "range": 30,
   "render_power": 3,
   "color": "0x33000000"
  },
  "animations_enabled": true,
  "anim": {
   "global": [
    5.0,
    "default"
   ],
   "windows": [
    5.5,
    "glassEase"
   ],
   "windowsIn": [
    5,
    "glassEase",
    "popin 90%"
   ],
   "windowsOut": [
    3.5,
    "glassEase",
    "popin 90%"
   ],
   "fadeIn": [
    1.73,
    "almostLinear"
   ],
   "fadeOut": [
    1.46,
    "almostLinear"
   ],
   "border": [
    3.0,
    "easeOutQuint"
   ],
   "fade": [
    4,
    "glassEase"
   ],
   "layersIn": [
    2.4,
    "easeOutQuint",
    "popin 87%"
   ],
   "layersOut": [
    2.4,
    "easeOutQuint",
    "popin 87%"
   ],
   "fadeLayersIn": [
    0.2,
    "quick"
   ],
   "fadeLayersOut": [
    1.8,
    "easeOut"
   ],
   "workspaces": [
    4,
    "glassEase",
    "slide"
   ]
  },
  "curves": {
   "glassEase": [
    0.16,
    1,
    0.3,
    1
   ]
  }
 },
 "mako": {
  "width": "380",
  "anchor": "top-right",
  "outer-margin": "56,18,0,0",
  "padding": "14",
  "border-size": "1",
  "border-radius": "14",
  "background-color": "#f5f5f7f5",
  "text-color": "#1d1d1f",
  "font": "Noto Sans 11",
  "icon-border-radius": 14,
  "body": "#6e6e73",
  "low": "#6e6e73",
  "low_border": "#566079",
  "crit": "#ff3b30",
  "crit_bg": "#fff1f0f2",
  "crit_body": "#ffd0d8",
  "border-color": "#d1d1d6",
  "low_text": "#6e6e73",
  "margin": "10",
  "default-timeout": "5000"
 },
 "lock": {
  "font": "CaskaydiaMono Nerd Font Propo",
  "bg": "e8ecf5",
  "panel": "ffffffd9",
  "inner": "ffffffee",
  "text": "1d1d1f"
 },
 "ghostty": {
  "background": "#f5f5f7",
  "foreground": "#1d1d1f",
  "cursor-color": "#0a84ff",
  "selection-background": "#b6d7ff",
  "selection-foreground": "#1d1d1f"
 },
 "wall": "wall.jpg",
 "dock": {
  "SIDE": "left",
  "AUTOHIDE": 1
 },
 "sound": {
  "normal": "notify-data",
  "critical": "crit-glass",
  "low": "low-tick",
  "volume": 0.6
 },
 "macdock": {
  "icon": 50,
  "bottom": 10,
  "apps": [
   {
    "name": "Finder",
    "id": "org.gnome.Nautilus",
    "cmd": "uwsm app -- nautilus --new-window",
    "cls": "org.gnome.Nautilus"
   },
   {
    "name": "Terminal",
    "id": "com.mitchellh.ghostty",
    "cmd": "uwsm app -- ghostty",
    "cls": "com.mitchellh.ghostty"
   },
   {
    "name": "Chrome",
    "id": "google-chrome",
    "cmd": "uwsm app -- google-chrome-stable",
    "cls": "google-chrome"
   },
   {
    "name": "Vivaldi",
    "id": "vivaldi-stable",
    "cmd": "uwsm app -- vivaldi-stable",
    "cls": "vivaldi-stable"
   },
   {
    "name": "VS Code",
    "id": "code",
    "cmd": "uwsm app -- code",
    "cls": "code"
   },
   {
    "name": "Telegram",
    "id": "org.telegram.desktop",
    "cmd": "uwsm app -- telegram-desktop",
    "cls": "org.telegram.desktop"
   }
  ],
  "autohide": true,
  "edge": 4,
  "hide_ms": 450
 }
}
