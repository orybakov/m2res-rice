#!/usr/bin/env bash
# m2res-tools ocr|color|qr|qrgen — экранные инструменты
#   ocr     выделить область → распознать текст (tesseract rus+eng) → в буфер обмена + уведомление
#   color   пипетка (hyprpicker): цвет #rrggbb в буфер обмена + уведомление
#   qr      выделить область → прочитать QR/штрихкод (zbarimg) → текст в буфер обмена; если это ссылка — предложит открыть
#   qrgen   текст из буфера обмена → QR-код (qrencode) → картинка в буфер и в ~/Pictures/Screenshots
# Для тестов: M2_TOOLS_IMG=файл.png — взять картинку вместо выделения мышью.
set -u
ACC=$(jq -r '.accent // "#b0d500"' "$HOME/.config/m2res/player/colors.json" 2>/dev/null || echo "#b0d500")
[ -d "$HOME/.local/share/m2res/tessdata" ] && export TESSDATA_PREFIX="$HOME/.local/share/m2res/tessdata"   # rus.traineddata без root
T=$(mktemp -d); trap 'rm -rf "$T"' EXIT
grab(){
  if [ -n "${M2_TOOLS_IMG:-}" ]; then cp "$M2_TOOLS_IMG" "$T/a.png"; return 0; fi
  local g; g=$(slurp -d -b '#000000a0' -c "${ACC}ff" -s "${ACC}22" -w 2) || return 1
  sleep 0.18; grim -g "$g" "$T/a.png"
}
N(){ notify-send -a "Screen tools" "$@"; }
case "${1:-}" in
  ocr)
    grab || exit 0
    convert_img="$T/a.png"
    # апскейл x2 для мелкого текста
    command -v magick >/dev/null && magick "$T/a.png" -resize 200% -colorspace Gray "$T/b.png" 2>/dev/null && convert_img="$T/b.png"
    txt=$(tesseract "$convert_img" - -l rus+eng --psm 6 2>/dev/null | sed 's/[[:space:]]*$//' | sed -e :a -e '/^\n*$/{$d;N;ba' -e '}')
    if [ -z "$txt" ]; then N "OCR: текст не найден"; exit 1; fi
    printf '%s' "$txt" | wl-copy; N "OCR → буфер обмена" "$(printf '%s' "$txt" | head -c 200)"; printf '%s\n' "$txt";;
  color)
    c=$(hyprpicker -a -f hex 2>/dev/null | tail -1)
    [ -n "$c" ] || exit 0
    printf '%s' "$c" | wl-copy; N "Цвет $c" "скопирован в буфер обмена"; echo "$c";;
  qr)
    grab || exit 0
    txt=$(zbarimg -q --raw "$T/a.png" 2>/dev/null)
    if [ -z "$txt" ]; then N "QR не найден" "выдели область плотнее"; exit 1; fi
    printf '%s' "$txt" | wl-copy
    if [[ "$txt" =~ ^https?:// ]]; then
      a=$(notify-send -a "Screen tools" -A open="Открыть" "QR: ссылка (в буфере)" "$txt" -t 8000 2>/dev/null); [ "$a" = open ] && xdg-open "$txt" >/dev/null 2>&1 &
    else N "QR → буфер обмена" "$txt"; fi
    printf '%s\n' "$txt";;
  qrgen)
    txt=$(wl-paste -n 2>/dev/null); [ -n "$txt" ] || { N "Буфер пуст"; exit 1; }
    mkdir -p "$HOME/Pictures/Screenshots"; f="$HOME/Pictures/Screenshots/qr-$(date +%F_%H-%M-%S).png"
    qrencode -s 12 -m 3 -o "$f" "$txt" && wl-copy --type image/png < "$f" && N "QR создан" "в буфере и в $(basename "$f")"; echo "$f";;
  *) echo "usage: $0 ocr|color|qr|qrgen" >&2; exit 2;;
esac
