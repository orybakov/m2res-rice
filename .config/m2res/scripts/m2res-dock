#!/usr/bin/env bash
# m2res-dock [toggle|start|stop|status] — боковая панель для 32:9 (ярлыки, мини-плеер, загрузка). Настройки: ~/.config/m2res/dock.conf
P="$HOME/.config/m2res/player/dock.py"
running(){ pgrep -f "^python3 $P" >/dev/null; }
start(){
  running && return
  local mon
  mon=$(hyprctl -j monitors | jq -r '(.[]|select(.focused)).name')
  M2_MON="$mon" LD_PRELOAD=/usr/lib/libgtk4-layer-shell.so setsid -f python3 "$P" >/tmp/m2res-dock.log 2>&1
}
case "${1:-toggle}" in
  start) start;;
  stop) pkill -f "^python3 $P" || true;;
  toggle) if running; then pkill -f "^python3 $P"; else start; fi;;
  status) running && echo on || echo off;;
  autostart) . "$HOME/.config/m2res/dock.conf"; r=$(hyprctl -j monitors | jq -r '[.[]|select(.focused)][0]|(.width/.height*100|floor)')
    [ "${AUTOSTART:-0}" = 1 ] && [ "${r:-0}" -ge 220 ] && start; true;;
esac
