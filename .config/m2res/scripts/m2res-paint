#!/usr/bin/env bash
# m2res-paint [apply|off|show] — акцент райса на рамки окон Hyprland (анимированный градиент) и на курсор/выделение Ghostty.
#   apply  читает акцент из player/colors.json: рамка активного окна = акцент → тёмный акцент (угол крутится: leaf borderangle loop),
#          неактивная — тусклая; пишет ~/.config/m2res/ghostty-accent.conf (cursor-color, selection-background) и просит открытые ghostty перечитать конфиг
#   off    вернуть прежнюю рамку (rgb(a5adcb)) и убрать акцент Ghostty
# Системные/dotfiles-темы не трогает: Ghostty подключает ghostty-accent.conf отдельной строкой config-file в самом конце ~/.config/ghostty/config.
# Постоянство после перезагрузки обеспечивает блок в hypr-m2res.lua (читает colors.json при загрузке конфига).
set -u
M2="$HOME/.config/m2res"; GC="$M2/ghostty-accent.conf"
acc(){ jq -r '.accent // "#b0d500"' "$M2/player/colors.json" 2>/dev/null || echo "#b0d500"; }
dark(){ python3 - "$1" <<'PY'
import sys; h=sys.argv[1].lstrip("#"); r,g,b=(int(h[i:i+2],16) for i in (0,2,4)); print("%02x%02x%02x"%(int(r*.35),int(g*.35),int(b*.35)))
PY
}
case "${1:-apply}" in
  apply)
    a=$(acc); a=${a#\#}; d=$(dark "$a")
    hyprctl eval "hl.config({ general = { col = { active_border = { colors = { 'rgba(${a}ff)', 'rgba(${d}ff)', 'rgba(${a}ff)' }, angle = 45 }, inactive_border = 'rgba(${a}30)' } } })" >/dev/null
    printf '# сгенерировано m2res-paint — не править\ncursor-color = #%s\nselection-background = #%s\nselection-foreground = #0a0a0a\n' "$a" "$a" > "$GC"
    grep -q 'ghostty-accent.conf' "$HOME/.config/ghostty/config" || printf '\n# m2res: акцент райса (курсор, выделение)\nconfig-file = ?"~/.config/m2res/ghostty-accent.conf"\n' >> "$HOME/.config/ghostty/config"
    pkill -USR2 -x ghostty 2>/dev/null; echo "paint: #$a";;
  off)
    hyprctl eval "hl.config({ general = { col = { active_border = 'rgb(a5adcb)', inactive_border = 'rgb(444444)' } } })" >/dev/null
    : > "$GC"; pkill -USR2 -x ghostty 2>/dev/null; echo "paint: off";;
  show) hyprctl getoption general:col.active_border | head -2; cat "$GC" 2>/dev/null;;
esac
